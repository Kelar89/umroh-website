---
export interface Props {
  namaPaket: string;
  harga: string;
  durasi: number;
  maskapai: string;
  imgSrc: any;
  href: string;
}
const { namaPaket, harga, durasi, maskapai, imgSrc, href } = Astro.props;
---
<div class="bg-white rounded-lg shadow-lg overflow-hidden transition-transform duration-300 hover:scale-105">
  <img src={imgSrc.src} alt={`Gambar ${namaPaket}`} class="w-full h-48 object-cover">
  <div class="p-6">
    <h3 class="text-xl font-bold text-gray-800 mb-2">{namaPaket}</h3>
    <p class="text-2xl font-extrabold text-teal-600 mb-4">{harga}</p>
    <div class="flex justify-between text-sm text-gray-600">
      <span>{durasi} Hari</span>
      <span>{maskapai}</span>
    </div>
    <a href={href} class="mt-6 block w-full text-center bg-gray-800 text-white py-2 rounded-md hover:bg-gray-700">
      Lihat Detail
    </a>
  </div>
</div>