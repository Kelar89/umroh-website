---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import PaketCard from '../components/PaketCard.astro';

// Impor semua gambar
import heroImage from '../assets/hero-bg.jpg';
import imgPaket1 from '../assets/paket1.jpg';
import imgPaket2 from '../assets/paket2.jpg';
import imgPaket3 from '../assets/paket3.jpg';
---

<Layout title="Home - Travel Umroh">
  <section
    class="relative h-[60vh] bg-cover bg-center text-white flex items-center justify-center text-center"
    style={`background-image: url(${heroImage.src})`}
  >
    <div class="absolute inset-0 bg-black opacity-50"></div>
    <div class="relative z-10 px-4">
      <h1 class="text-4xl md:text-6xl font-extrabold">Mewujudkan Perjalanan Suci Anda</h1>
      <p class="mt-4 text-lg md:text-xl max-w-2xl mx-auto">Pengalaman umroh tak terlupakan dengan pelayanan terbaik dan bimbingan khusyuk.</p>
      <a href="/paket" class="mt-8 inline-block px-8 py-3 bg-teal-500 hover:bg-teal-600 rounded-full font-bold transition">
        Lihat Semua Paket
      </a>
    </div>
  </section>

  <section class="py-16 bg-gray-100">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-center text-gray-800 mb-10">Paket Umroh Unggulan</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <PaketCard
          namaPaket="Umroh Berkah Awal Musim"
          harga="Rp 25 Juta"
          durasi={9}
          maskapai="Saudia"
          imgSrc={imgPaket1}
        />
        <PaketCard
          namaPaket="Umroh Spesial Ramadhan"
          harga="Rp 35 Juta"
          durasi={12}
          maskapai="Garuda"
          imgSrc={imgPaket2}
        />
        <PaketCard
          namaPaket="Umroh Keluarga Hemat"
          harga="Rp 23 Juta"
          durasi={9}
          maskapai="Lion Air"
          imgSrc={imgPaket3}
        />
      </div>
    </div>
  </section>
</Layout>