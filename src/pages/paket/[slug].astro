---
// src/pages/paket/[slug].astro
import Layout from '../../layouts/Layout.astro';
import imgPaket1 from '../../assets/paket1.jpg';
import imgPaket2 from '../../assets/paket2.jpg';
import imgPaket3 from '../../assets/paket3.jpg';

export function getStaticPaths() {
  // "DATABASE" PAKET SEKARANG ADA DI DALAM FUNGSI INI
  const semuaPaket = [
    {
      slug: 'umroh-berkah',
      namaPaket: 'Umroh Berkah Awal Musim',
      harga: 'Rp 25.000.000',
      deskripsi: 'Nikmati kekhusyukan beribadah di awal musim yang lebih tenang. Sangat cocok bagi Anda yang mendambakan suasana damai.',
      fasilitas: ['Hotel Bintang 4 (Mekkah & Madinah)', 'Makan 3x Sehari (Menu Indonesia)', 'Transportasi Bus AC', 'Air Zamzam 5 Liter'],
      itinerari: 'Rencana perjalanan detail hari per hari akan diberikan saat pendaftaran.',
      imgSrc: imgPaket1
    },
    {
      slug: 'umroh-spesial-ramadhan',
      namaPaket: 'Umroh Spesial Ramadhan',
      harga: 'Rp 35.000.000',
      deskripsi: 'Raih pahala berlipat ganda dengan beribadah umroh di bulan suci Ramadhan. Pengalaman spiritual yang tak ternilai.',
      fasilitas: ['Hotel Bintang 5 Dekat Masjidil Haram', 'Saur & Buka Puasa Bersama', 'Transportasi Bus AC Premium', 'Mutawwif Berpengalaman'],
      itinerari: 'Rencana perjalanan mencakup itikaf dan shalat tarawih berjamaah.',
      imgSrc: imgPaket2
    },
    {
      slug: 'umroh-keluarga-hemat',
      namaPaket: 'Umroh Keluarga Hemat',
      harga: 'Rp 23.000.000',
      deskripsi: 'Paket ekonomis yang dirancang khusus untuk keluarga, tanpa mengurangi kualitas dan kenyamanan ibadah Anda.',
      fasilitas: ['Hotel Bintang 3', 'Makan 3x Sehari', 'Transportasi Bus AC', 'Manasik Umroh Lengkap'],
      itinerari: 'Jadwal fleksibel yang cocok untuk anak-anak dan lansia.',
      imgSrc: imgPaket3
    }
  ];

  return semuaPaket.map(paket => ({
    params: { slug: paket.slug },
    props: { paket },
  }));
}

const { paket } = Astro.props;

const nomorWhatsApp = '6281234567890'; // GANTI DENGAN NOMOR WA ANDA
const pesanWhatsApp = `Assalamualaikum, saya tertarik dengan paket "${paket.namaPaket}" seharga ${paket.harga}. Mohon info lebih lanjut.`;
const linkWhatsApp = `https://wa.me/${nomorWhatsApp}?text=${encodeURIComponent(pesanWhatsApp)}`;
---
<Layout title={`Detail Paket - ${paket.namaPaket}`}>
  <div class="container mx-auto px-6 py-12">
    <div class="text-center mb-10">
      <h1 class="text-4xl font-extrabold text-gray-800">{paket.namaPaket}</h1>
      <p class="text-3xl font-bold text-teal-600 mt-2">{paket.harga}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-1">
        <img src={paket.imgSrc.src} alt={`Gambar ${paket.namaPaket}`} class="rounded-lg shadow-xl w-full mb-6">
        <a href={linkWhatsApp} target="_blank" class="block w-full text-center text-xl font-bold bg-green-500 text-white py-4 rounded-lg hover:bg-green-600 transition">
          Pesan via WhatsApp
        </a>
      </div>

      <div class="lg:col-span-2 bg-white p-8 rounded-lg shadow-xl">
        <h2 class="text-2xl font-bold border-b pb-2 mb-4">Deskripsi Paket</h2>
        <p class="text-gray-700 mb-6">{paket.deskripsi}</p>

        <h2 class="text-2xl font-bold border-b pb-2 mb-4">Fasilitas Termasuk</h2>
        <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
          {paket.fasilitas.map(item => <li>{item}</li>)}
        </ul>

        <h2 class="text-2xl font-bold border-b pb-2 mb-4">Itinerari</h2>
        <p class="text-gray-700">{paket.itinerari}</p>
      </div>
    </div>
  </div>
</Layout>